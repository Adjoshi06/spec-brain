# Copy to .env and fill in. Never commit .env.

# --- Agent (AWS Strands + Claude) ---
ANTHROPIC_API_KEY=
# Required when the key is org-level (not workspace-scoped): Console -> Settings -> Workspaces
ANTHROPIC_WORKSPACE_ID=
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=medium
# Name used to sign the substitution request (the persona)
USER_NAME=

# --- Cognee (graph extraction + embeddings; uses OpenAI) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Keep Cognee's storage inside this repo (forward slashes on Windows)
DATA_ROOT_DIRECTORY=C:/Users/adjos/Documents/BrighData/spec-brain/.cognee/data
SYSTEM_ROOT_DIRECTORY=C:/Users/adjos/Documents/BrighData/spec-brain/.cognee/system

# --- Bright Data ---
BRIGHTDATA_API_TOKEN=

# --- Google (put credentials.json next to this file; token.json is created on first run) ---
# Where the substitution request is sent. Use your own address for the demo.
CONTRACTOR_EMAIL=

# --- Optional: Cognee Cloud push at the end ---
COGNEE_CLOUD_URL=
COGNEE_CLOUD_API_KEY=
